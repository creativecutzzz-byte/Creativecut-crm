# Copy to .env.local and fill in. Never commit real credentials.
# Leave the Supabase values empty to run the UI in demo mode with sample data.

# --- Supabase (public, safe for the browser; protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Integrations (server-only; leave empty until you connect each service) ---
# Step-by-step setup (Hindi): docs/meta-setup.md
#
# Master switch. Only the exact value "live" sends real WhatsApp / Instagram
# messages; anything else previews them (dry-run). Remove it to stop sending.
MESSAGING_MODE=dry-run

# Public URL of the deployed CRM (used to show the webhook callback URL).
NEXT_PUBLIC_SITE_URL=

# WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Language code of your approved templates (e.g. en, en_US, hi)
WHATSAPP_TEMPLATE_LANGUAGE=en
# Added in front of 10-digit numbers (91 = India)
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Instagram API with Instagram login (your app → Instagram → API setup)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=

# Webhook (one URL for both: https://<your-domain>/api/webhooks/meta)
META_APP_SECRET=
# Any random string you choose; paste the same value in the Meta dashboard
META_WEBHOOK_VERIFY_TOKEN=
# Workspace key shown on Settings → Website lead capture
META_WEBHOOK_WORKSPACE=
# Supabase → Project Settings → API → service_role. Server-only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Ads (read-only analytics)
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0

# --- AI agents (docs/ai-sales-system.md) ---
# Claude: the agents' brain (console.anthropic.com → API keys). Server-only.
ANTHROPIC_API_KEY=
# Set to false to keep the key but run every agent in its rule-based mode (no AI cost).
# AI_ENABLED=true
# Optional: model and effort. claude-haiku-5-5 is much cheaper for high volume.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# Apollo.io (Settings → Integrations → API). Revealing an email costs 1 credit.
APOLLO_API_KEY=
# Google Cloud → APIs & Services → enable "Places API (New)" → Credentials
GOOGLE_MAPS_API_KEY=
# Random string; Vercel Cron sends it to /api/cron/agents (daily, see vercel.json).
# Also signs the one-click unsubscribe links in outreach emails.
CRON_SECRET=

# --- Outreach email via Google Workspace (docs/google-workspace-setup.md) ---
# Service account with domain-wide delegation for the gmail.modify scope.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The JSON key's private_key, including -----BEGIN/END PRIVATE KEY----- (keep the \n).
GOOGLE_SERVICE_ACCOUNT_KEY=
# Outreach mailbox on a separate domain, e.g. aanya@creativecut.co
GMAIL_SENDER=
GMAIL_SENDER_NAME=
# --- Free: Google Apps Script on your Gmail (docs/google-apps-script-setup.md) ---
# Booking calendar + alert/brief emails, no Google Cloud project.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=
# Optional: the Gmail address the script runs as
# GOOGLE_SCRIPT_EMAIL=

# --- Razorpay (read-only Sales screen): Dashboard -> Account & Settings -> API keys (Live) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Or a plain @gmail.com account via "Connect Google" (docs/google-gmail-setup.md) ---
# Calendar + sending alerts/brief. Client from Google Cloud -> Credentials -> OAuth client (Web).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Shown once after Settings -> Connect Google:
GOOGLE_OAUTH_EMAIL=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Calendar used for the booking page and meeting sync (same service account,
# scope https://www.googleapis.com/auth/calendar), e.g. hello@creativecut.in
GOOGLE_CALENDAR_USER=

# --- Display ---
# Currency for every amount in the CRM (ISO code, e.g. INR, USD, EUR). Defaults to USD.
NEXT_PUBLIC_CURRENCY=INR

# --- Outreach Engine (docs/outreach-engine/README.md) ---
# Postgres for the engine's own `outreach` schema. Supabase: Project Settings -> Database ->
# Connection string (transaction pooler, port 6543). Then run: npm run migrate
DATABASE_URL=
# DATABASE_SSL=disable          # only for a local Postgres
# Model chain in fallback order (drafting), and the small-model chain (scoring, classification).
MODEL_CHAIN=claude-sonnet-5-5,claude-haiku-5-5
SMALL_MODEL_CHAIN=claude-haiku-5-5,claude-sonnet-5-5
# Service account JSON key, base64-encoded (base64 -w0 key.json). Domain-wide delegation scopes:
# https://www.googleapis.com/auth/gmail.send, https://www.googleapis.com/auth/gmail.readonly
GOOGLE_SA_KEY_B64=
# Email verification: zerobounce | neverbounce (or "none" ONLY for a list verified elsewhere)
VERIFY_PROVIDER=zerobounce
VERIFY_API_KEY=
# Signs unsubscribe tokens (random, 32+ chars). Links point at UNSUB_BASE_URL/api/engine/unsubscribe.
UNSUB_SECRET=
UNSUB_BASE_URL=
# Slack incoming webhook (or anything that accepts {"text": "..."}) for guard alerts and hot replies.
ALERT_WEBHOOK_URL=
# Only these Workspace domains may open /engine (comma-separated), e.g. creativecut.in
ALLOWED_LOGIN_DOMAIN=
# Show "Continue with Google" on /login (enable the Google provider in Supabase Auth first).
# SUPABASE_GOOGLE_LOGIN=true
# Identity used in prompts and the plain-text signature. Add a postal address if your regions require it.
OUTREACH_COMPANY_NAME=Creative Cut
OUTREACH_OFFER=
OUTREACH_POSTAL_ADDRESS=
# Recipient-local send window (24h clock, Mon-Fri) and fallback time zone.
# SEND_WINDOW_START=8
# SEND_WINDOW_END=11
# OUTREACH_DEFAULT_TIMEZONE=UTC
# Per-tick batch sizes for /api/cron/research.
# VERIFY_BATCH=25
# QUALIFY_BATCH=10
# RESEARCH_BATCH=8
# Kill switch for all engine cron jobs.
# ENGINE_ENABLED=false
# Sending ALSO requires MESSAGING_MODE=live (above). Until then nothing is emailed.
