# Copy to .env.local and fill in. Never commit real credentials.
# Leave the Supabase values empty to run the UI in demo mode with sample data.

# --- Supabase (public, safe for the browser; protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Integrations (server-only; leave empty until you connect each service) ---
# Step-by-step setup (Hindi): docs/meta-setup.md
#
# Master switch. Only the exact value "live" sends real WhatsApp / Instagram
# messages; anything else previews them (dry-run). Remove it to stop sending.
MESSAGING_MODE=dry-run

# Public URL of the deployed CRM (used to show the webhook callback URL).
NEXT_PUBLIC_SITE_URL=

# WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Language code of your approved templates (e.g. en, en_US, hi)
WHATSAPP_TEMPLATE_LANGUAGE=en
# Added in front of 10-digit numbers (91 = India)
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Instagram API with Instagram login (your app → Instagram → API setup)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=

# Webhook (one URL for both: https://<your-domain>/api/webhooks/meta)
META_APP_SECRET=
# Any random string you choose; paste the same value in the Meta dashboard
META_WEBHOOK_VERIFY_TOKEN=
# Workspace key shown on Settings → Website lead capture
META_WEBHOOK_WORKSPACE=
# Supabase → Project Settings → API → service_role. Server-only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Ads (read-only analytics)
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0

# --- AI agents (docs/ai-sales-system.md) ---
# Claude: the agents' brain (console.anthropic.com → API keys). Server-only.
ANTHROPIC_API_KEY=
# Optional: model and effort. claude-haiku-5-5 is much cheaper for high volume.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# Apollo.io (Settings → Integrations → API). Revealing an email costs 1 credit.
APOLLO_API_KEY=
# Google Cloud → APIs & Services → enable "Places API (New)" → Credentials
GOOGLE_MAPS_API_KEY=
# Random string; Vercel Cron sends it to /api/cron/agents (daily, see vercel.json).
# Also signs the one-click unsubscribe links in outreach emails.
CRON_SECRET=

# --- Outreach email via Google Workspace (docs/google-workspace-setup.md) ---
# Service account with domain-wide delegation for the gmail.modify scope.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The JSON key's private_key, including -----BEGIN/END PRIVATE KEY----- (keep the \n).
GOOGLE_SERVICE_ACCOUNT_KEY=
# Outreach mailbox on a separate domain, e.g. aanya@creativecut.co
GMAIL_SENDER=
GMAIL_SENDER_NAME=
# Calendar used for the booking page and meeting sync (same service account,
# scope https://www.googleapis.com/auth/calendar), e.g. hello@creativecut.in
GOOGLE_CALENDAR_USER=

# --- Display ---
# Currency for every amount in the CRM (ISO code, e.g. INR, USD, EUR). Defaults to USD.
NEXT_PUBLIC_CURRENCY=INR
